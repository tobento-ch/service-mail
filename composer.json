{
    "name": "tobento/service-mail",
    "version": "2.0",
    "type": "library",
    "description": "Mailer interface for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "mail",
        "email"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-view": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-autowire": "^2.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/mailer": "^7.3",
        "tijsverkoyen/css-to-inline-styles": "^2.3"
    },
    "suggest": {
        "tobento/service-queue": "May be used to support queuing messages"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-event": "^2.0",
        "tobento/service-container": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-queue": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Mail\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Mail\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}